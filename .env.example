# =====================================================================
# GeoVerify WebGIS - Environment Configuration
# =====================================================================
# By default, GeoVerify uses OpenStreetMap Nominatim for Geocoding.
# Nominatim is 100% FREE and requires NO API KEY or sign-up!
#
# OPTIONAL: If you want to use Mapbox or Google Maps Geocoding:
# 1. Mapbox: Sign up at https://mapbox.com -> Create a Public Token -> paste below
# 2. Google: Go to https://console.cloud.google.com -> Enable Geocoding API -> create API Key -> paste below
# =====================================================================

# Geocoding Provider: 'nominatim' (Free, No Key needed) | 'mapbox' | 'google'
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim

# Optional Geocoding API Key (Leave empty if using default Free Nominatim)
NEXT_PUBLIC_GEOCODING_API_KEY=

# Default MQTT Telemetry Broker Configuration for Physical RTK Rover
NEXT_PUBLIC_MQTT_BROKER=wss://broker.hivemq.com:8884/mqtt
NEXT_PUBLIC_MQTT_TOPIC=geoverify/demo/zahid/location

# Optional Serverless DB / Firebase Configuration for Cloud Project Sync
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
